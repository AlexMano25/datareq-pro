# DataReq Pro — variables d'environnement
# Copier en .env.local (dev) ou dans /opt/apps/datareq/app/api.env (VPS).
# Ne jamais commiter de valeurs réelles.

# --- Supabase auto-hébergé (PostgREST + GoTrue derrière Caddy) ---
NEXT_PUBLIC_SUPABASE_URL=https://datareq-db.manovende.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role : routes serveur uniquement (paiements, webhook, soumission publique)
SUPABASE_SERVICE_ROLE_KEY=

# --- Application ---
NEXT_PUBLIC_APP_URL=https://rgpd.manovende.com
NEXT_PUBLIC_SITE_URL=https://rgpd.manovende.com

# --- Paiements : règle métier ---
#   Carte bancaire            → CamPay (lien de paiement get_payment_link)
#   Orange Money / MTN MoMo   → Y-Note (push USSD)

# --- CamPay (carte bancaire uniquement) ---
# DEMO ou PROD
CAMPAY_ENVIRONMENT=DEMO
CAMPAY_APP_USERNAME=
CAMPAY_APP_PASSWORD=
# Secret attendu dans l'en-tête "Authorization: Bearer <secret>" du webhook
CAMPAY_WEBHOOK_SECRET=

# --- Y-Note / PayNote (Orange Money + MTN Mobile Money) ---
# OAuth2 client_credentials (https://omapi-token.ynote.africa/oauth2/token)
YNOTE_CLIENT_ID=
YNOTE_CLIENT_SECRET=
# Identifiants marchand API_MUT (webpayment)
YNOTE_CUSTOMER_KEY=
YNOTE_CUSTOMER_SECRET=
# Optionnel : URL de statut (défaut https://omapi.ynote.africa/prod/webpaymentmtn/status)
# YNOTE_STATUS_URL=
